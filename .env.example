# ─────────────────────────────────────────────────────────────
# .env.example — 이 파일을 복사해 .env 로 만든 뒤 각자 값을 채운다.
#   copy .env.example .env      (cmd)
#   Copy-Item .env.example .env (PowerShell)
#
# .env 는 .gitignore 대상이라 깃에 올라가지 않아야 한다.
# 이 파일(.env.example)에는 실제 값을 절대 적지 않는다.
# ─────────────────────────────────────────────────────────────

# ── DB 접속 (Docker MySQL) ──
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=<본인 DB 비밀번호>
DB_NAME=board_db

# ── 로그인 토큰 서명 키 (필수) ──
# 비어 있으면 app.py 가 기동을 거부한다. 만드는 법:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=<32자 이상 랜덤 문자열>
JWT_EXPIRES_HOURS=24

# ── Flask ──
FLASK_PORT=5000
FLASK_DEBUG=True

# ── 보안 이벤트 REST 용 API 키 (n8n 과 공유) ──
# 비어 있으면 POST /api/security/events 는 항상 401 (fail-closed)
SECURITY_API_KEY=<32자 이상 랜덤 문자열>

# ── n8n Webhook (alert_sender.py 가 사용) ──
# n8n 워크플로우의 Webhook 노드에서 복사한 Production/Test URL
N8N_WEBHOOK_URL=http://localhost:5678/webhook/<본인 워크플로우 ID>
N8N_TIMEOUT=10

# 채점 증적용 식별자 (본인 이름/학번)
STUDENT=<본인 식별자>

# ── 공공데이터포털(data.go.kr) 서비스 키 (선택) ──
# 비워 두면 /api/busan-themes 는 내장 샘플 데이터로 응답한다.
OPENAPI_SERVICE_KEY=
